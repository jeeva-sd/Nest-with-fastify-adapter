{
    "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",

    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },

    "files": {
        "ignoreUnknown": false,
        "includes": ["src/**/*"]
    },

    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },

    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,

            "complexity": {
                "noForEach": "off",
                "useLiteralKeys": "off",
                "noExtraBooleanCast": "warn",
                "noStaticOnlyClass": "off",
                "noUselessConstructor": "off"
            },

            "correctness": {
                "noUnusedImports": "warn",
                "noUnusedVariables": "warn",
                "noUnsafeFinally": "warn",
                "noUnsafeOptionalChaining": "warn",
                "noConstAssign": "error"
            },

            "style": {
                "useImportType": "off",
                "useConst": "warn",
                "useObjectSpread": "warn",
                "useShorthandAssign": "warn",
                "useNumericSeparators": "warn",
                "useTemplate": "warn",
                "useArrayLiterals": "warn"
            },

            "suspicious": {
                "noDebugger": "warn",
                "noAsyncPromiseExecutor": "warn",
                "noExplicitAny": "warn",
                "noMisleadingCharacterClass": "warn"
            }
        }
    },

    "javascript": {
        "parser": {
            "unsafeParameterDecoratorsEnabled": true
        },
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "trailingCommas": "none",
            "arrowParentheses": "asNeeded",
            "bracketSameLine": false
        }
    },

    "json": {
        "formatter": {
            "enabled": true
        }
    }
}
