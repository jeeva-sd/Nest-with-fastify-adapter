{
    "server": {
        "port": 3010,
        "version": "1",
        "routePrefix": "api",
        "mode": "development",
        "host": "0.0.0.0",
        "allowExceptionLogs": false,
        "bufferLogs": true,
        "abortOnError": false
    },
    "fastify": {
        "adapter": {
            "logger": false,
            "trustProxy": true,
            "ignoreTrailingSlash": true,
            "ignoreDuplicateSlashes": true,
            "caseSensitive": false,
            "maxParamLength": 100,
            "bodyLimit": 1048576
        },
        "hooks": {
            "performanceLogging": true,
            "slowRequestThreshold": 100,
            "enableRequestTiming": true
        }
    },
    "plugins": {
        "helmet": {
            "enabled": true
        },
        "cors": {
            "enabled": true,
            "origin": ["http://localhost:3000"],
            "credentials": true,
            "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
        },
        "cookies": {
            "enabled": true
        },
        "multipart": {
            "enabled": true,
            "attachFieldsToBody": false,
            "sharedSchemaId": "MultipartFileType",
            "limits": {
                "fileSize": 5242880,
                "fieldSize": 1048576,
                "fields": 10,
                "files": 1
            }
        },
        "csrf": {
            "enabled": true
        },
        "static": {
            "enabled": true,
            "root": "public",
            "prefix": "/static/",
            "maxAge": 2592000000,
            "etag": true,
            "lastModified": true,
            "immutable": true,
            "cacheControl": true
        },
        "rateLimit": {
            "enabled": true,
            "max": 100,
            "timeWindow": "1 minute",
            "allowList": ["127.0.0.1"],
            "ban": 1,
            "skipOnError": true,
            "addHeaders": true
        },
        "compression": {
            "enabled": true,
            "encodings": ["gzip", "deflate", "br"],
            "threshold": 1024,
            "zlibLevel": 6,
            "chunkSize": 1024,
            "contentTypeFilter": "^text/|\\+json$|\\+text$|\\+xml$",
            "brotliOptions": {
                "params": {
                    "BROTLI_PARAM_QUALITY": 4
                }
            }
        }
    },
    "database": {
        "sql": {
            "performance": {
                "poolTimeout": 20,
                "socketTimeout": 30,
                "connectTimeout": 10,
                "queryTimeout": 30000
            }
        }
    },
    "microservices": {
        "rabbitmq": {
            "enabled": true,
            "continueOnFailure": true,
            "uri": "amqp://localhost:5672",
            "exchange": {
                "name": "default_exchange",
                "type": "topic",
                "options": {
                    "arguments": {
                        "x-delayed-type": "topic"
                    }
                }
            },
            "queues": {
                "general": {
                    "name": "general_queue",
                    "prefetchCount": 10,
                    "durable": true
                },
                "singleConsumerQueue": {
                    "name": "single_consumer_queue",
                    "prefetchCount": 1,
                    "durable": true
                }
            }
        }
    },
    "monitoring": {
        "performance": {
            "enabled": true,
            "slowRequestThreshold": 1000,
            "mediumRequestThreshold": 500,
            "fastRequestThreshold": 100
        },
        "memory": {
            "enabled": true,
            "warningThreshold": 52428800,
            "criticalThreshold": 104857600,
            "checkInterval": 30000
        },
        "startup": {
            "logProcessInfo": true
        }
    },
    "gracefulShutdown": {
        "enabled": true,
        "signals": ["SIGTERM", "SIGINT"],
        "logShutdown": true
    },
    "auth": {
        "skipJwtAuthKey": "cm4yg6uzn00000cjf6sgm90dy",
        "encryptionKey": "cm4ybfhbd00000cmkbov75r84",
        "publicAuthKey": "cm8n1jewx000k0cl2drme2exe",
        "roleKey": "cm4ymtxoy00000cmhhh7d63fr",
        "permissionKey": "cm4ymt0x00000cmh7j8v2g3r5",
        "basicJWT": {
            "name": "basicJWT",
            "secret": "cm4l37kx000010cl42l2d3jck",
            "expiresIn": "5h"
        }
    },
    "payloadValidation": {
        "abortEarly": true,
        "stripUnknown": true,
        "recursive": true,
        "decoratorKey": "cm4yia5rb00090cl5hqk2hii6"
    },
    "interceptors": {
        "response": {
            "format": true,
            "formatKey": "cma80fcss00020cjsflrtd006",
            "skipFormatKey": "cma81qmo700070cif5pop4mov"
        }
    },
    "views": {
        "engine": "handlebars",
        "templatesDir": "src/views"
    }
}
